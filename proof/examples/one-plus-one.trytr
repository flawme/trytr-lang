@document(version: 1, width: 760, height: 500) {
    @heading #title {A proof from the addition axioms}
    @text #numerals {Define 1 = S(0) and 2 = S(S(0)), where S means successor.}
    @text #addition {Addition follows two recursive rules:}
    @math #zero-rule {a + 0 = a}
    @math #successor-rule {a + S(b) = S(a + b)}
    @text #derivation {Now apply the successor rule, then the zero rule:}
    @math #step-one {1 + 1 = S(0) + S(0)}
    @math #step-two {S(0) + S(0) = S(S(0) + 0)}
    @math #step-three {S(S(0) + 0) = S(S(0))}
    @math #step-four {S(S(0)) = 2}
    @text #conclusion {Therefore 1 + 1 = 2. The companion .trproof file checks this reduction.}
}
