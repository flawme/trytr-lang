@document(version: 1) {
    @param #n(min: 1, max: 12, value: 3, step: 1) {Selected integer}

    @heading #title(inline-math: true) {Working with \(x^2\)}
    @text #definition(inline-math: true) {
        Let \(x = #n\). The expression \(x^2\) stays inside this paragraph.
    }
    @text #fraction(inline-math: true) {
        A fraction such as \(\frac{1}{x + 1}\) can sit beside ordinary words.
    }
    @text #root(inline-math: true) {
        If \(x > 0\), then \(\sqrt{x^2} = x\). This is rendered notation.
    }
    @math #display {\frac{1}{1 + \frac{x^2}{1 + \sqrt{1 + x^2}}}}
    @text #literal(inline-math: true) {
        The price $5 is ordinary text. Write \\(x\\) to show literal delimiters.
    }
}
