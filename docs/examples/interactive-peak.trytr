@document(version: 1, width: 720, height: 420) {
    @param #peak(min: 8, max: 48, value: 24, step: 2) {Peak height}
    @heading #title {A value connected to an equation and a curve}
    @text #description {Current peak: #peak. This value also appears in the equation and curve.}
    @math #equation {middle value = #peak}
    @plot #response(56, 128, 640, 250) (stroke:rgb(37,99,235), stroke-width:3,
                                       grid:true, markers:true) {
        0, 10  1, 16  2, #peak  3, 20  4, 32  5, 36
    }
}
