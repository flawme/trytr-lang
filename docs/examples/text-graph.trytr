@document(version: 1, width: 100, height: 50) {
    @heading #title {Monthly revenue}
    @text #summary {Revenue rises from January through June.}
    @line #x-axis(0, 0, 100, 0)
    @line #y-axis(0, 0, 0, 42)
    @path #series { M 5 5 C 18 8 22 14 36 13 C 50 12 53 24 68 23 C 80 22 84 32 96 37 }
}
