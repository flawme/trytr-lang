@document(version: 1) {
    @param #rate(min: 1, max: 4, value: 2, step: 1) {Wave frequency}

    @heading #title {One document, one reading order}
    @text #intro(inline-math: true) {
        Text, equations, and a graph follow each other. The selected frequency
        is \(#rate\); changing it updates both the equation and the curve.
    }

    @math #equation {f(x) = \sin(#rate x)}
    @text #before-plot {The curve below uses the same frequency.}
    @plot #wave(48, 12, 520, 180)
        (x-min: -3, x-max: 3,
         samples: 33, markers: false, stroke: rgb(37, 99, 135), stroke-width: 3) {
        y = sin(#rate * x)
    }

    @text #after-plot {
        This paragraph comes after the graph. A taller equation also moves
        the following paragraph down when the browser measures its height.
    }
    @math #fraction {\frac{1}{1 + \frac{x^2}{1 + \sqrt{1 + x^2}}}}
    @text #closing {This sentence follows the complete fraction.}
}
